{
    "name": "capell-app/demo-kit",
    "description": "Generates example sites, pages, media and sample users for local and test copies of Capell, with a reviewed plan and a reset.",
    "keywords": [
        "capell",
        "demo",
        "demo-data",
        "deterministic-seed",
        "fixtures",
        "laravel",
        "filamentphp",
        "cms",
        "qa-tooling",
        "screenshot-automation"
    ],
    "homepage": "https://github.com/capell-app/demo-kit",
    "license": "proprietary",
    "authors": [
        {
            "name": "Howdu",
            "email": "capell.app26@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0.78",
        "capell-app/core": "^1.0.75",
        "capell-app/frontend": "^1.0",
        "capell-app/layout-builder": "^1.0",
        "capell-app/theme-foundation": "^1.0",
        "fakerphp/faker": "^1.24.1"
    },
    "suggest": {
        "capell-app/form-builder": "Seeds the Foundation showcase booking page with its Form Builder form.",
        "capell-app/html-cache": "Lets the demo health check confirm HTML cache eligibility diagnostics.",
        "capell-app/navigation": "Builds the demo site's main, footer and example navigation menus."
    },
    "autoload": {
        "psr-4": {
            "Capell\\DemoKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\DemoKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\DemoKit\\Providers\\DemoKitServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "type": "library",
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/demo-kit"
    }
}
