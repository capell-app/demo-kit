{
    "manifest-version": 3,
    "name": "capell-app/demo-kit",
    "slug": "demo-kit",
    "displayName": "Demo Kit",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Deterministic demo-data orchestration for Capell — seeds users, sites, languages, pages, media and a Foundation showcase homepage, and dispatches per-package demo commands.",
    "product": {
        "group": "Capell Foundation",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\DemoKit",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\DemoKit\\Providers\\DemoKitServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:demo-kit-full-demo",
        "demoParams": [
            "url",
            "user",
            "languages",
            "sites",
            "site-count",
            "page-count",
            "seed",
            "allow-production",
            "force"
        ],
        "doctor": "capell:demo-kit-doctor"
    },
    "settings": [],
    "permissions": [],
    "capabilities": [],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["demo-kit"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "demo-kit.package-health",
            "label": "Demo Kit declares the Capell API version it is compatible with so Diagnostics can flag version mismatches.",
            "class": "Capell\\DemoKit\\Health\\DemoKitHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "The demo engine for Capell: deterministic, multi-site, multi-language sample content and media. Generates a curated showcase site, fans out to each installed package's own demo command, and ships a health doctor so every demo, screenshot, and QA run starts from known data.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Demo Kit extension preview image",
                "caption": "Demo Kit extension preview"
            }
        ],
        "categories": ["admin", "foundation", "frontend"]
    },
    "contributionTraceability": {
        "deferredContributions": ["admin-page", "asset", "configurator"]
    }
}
