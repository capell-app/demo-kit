{
    "manifest-version": 3,
    "name": "capell-app/demo-kit",
    "slug": "demo-kit",
    "displayName": "Demo Kit",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Deterministic demo-data orchestration for Capell — seeds users, sites, languages, pages, media and a Foundation showcase homepage, and dispatches per-package demo commands.",
    "product": {
        "group": "Capell Foundation",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\DemoKit",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\DemoKit\\Providers\\DemoKitServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitAdminPageContribution",
            "pageClass": "Capell\\DemoKit\\Filament\\Pages\\DemoKitPage",
            "labelKey": "capell-demo-kit::page.title"
        },
        {
            "type": "configurator",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitConfiguratorContribution",
            "configuratorClasses": [
                "Capell\\DemoKit\\Filament\\Configurators\\Widgets\\HomepageSectionWidgetConfigurator"
            ],
            "groups": ["layout-widget"]
        },
        {
            "type": "asset",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitAssetsContribution",
            "surface": "frontend",
            "assets": [
                "resources/views/**/*.blade.php",
                "resources/css/demo-homepage.css",
                "demo/img/test.svg",
                "demo/video/SampleVideo_1280x720_1mb.mp4"
            ]
        },
        {
            "type": "frontend-component",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitFrontendComponentsContribution",
            "componentClasses": [
                "Capell\\DemoKit\\Livewire\\KitchenSinkStressWidget",
                "Capell\\DemoKit\\Livewire\\ResourcesLibrary",
                "Capell\\DemoKit\\Support\\KitchenSinkPublicWidgetPayloadContributor"
            ]
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitRenderablesContribution",
            "renderableKeys": [
                "capell.widget.demo-page-content",
                "capell.widget.homepage-section",
                "capell-demo-kit.widget.kitchen-sink-livewire-stress"
            ],
            "bladeViews": [
                "capell-demo-kit::widget.demo-page-content",
                "capell-demo-kit::widget.homepage-section"
            ],
            "livewireComponents": ["capell-demo-kit.kitchen-sink-stress-widget"]
        },
        {
            "type": "console-command",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitConsoleCommandsContribution",
            "commands": [
                "capell:demo",
                "capell:admin-demo",
                "capell:demo-kit-full-demo",
                "capell:demo-kit-doctor",
                "capell:demo-kit-refresh-stitch-pages",
                "capell:kitchen-sink-demo"
            ],
            "commandClasses": [
                "Capell\\DemoKit\\Console\\Commands\\DemoCommand",
                "Capell\\DemoKit\\Console\\Commands\\AdminDemoCommand",
                "Capell\\DemoKit\\Console\\Commands\\FullDemoCommand",
                "Capell\\DemoKit\\Console\\Commands\\DemoKitDoctorCommand",
                "Capell\\DemoKit\\Console\\Commands\\RefreshDemoStitchPagesCommand",
                "Capell\\DemoKit\\Console\\Commands\\KitchenSinkDemoCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\DemoKit\\Health\\DemoKitHealthCheck",
            "checkClass": "Capell\\DemoKit\\Health\\DemoKitHealthCheck"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:demo-kit-full-demo",
        "demoParams": [
            "url",
            "user",
            "languages",
            "sites",
            "site-count",
            "page-count",
            "packages",
            "theme",
            "seed",
            "quick",
            "reset",
            "skip-demo-users",
            "allow-production",
            "force"
        ],
        "doctor": "capell:demo-kit-doctor"
    },
    "settings": [],
    "permissions": [],
    "capabilities": [],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\DemoKit\\Actions\\RedactDemoKitErrorMessageAction",
                "Capell\\DemoKit\\Console\\Commands\\AdminDemoCommand",
                "Capell\\DemoKit\\Filament\\Pages\\DemoKitPage"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\DemoKit\\Support\\Creator\\DemoResourceResolver"
            ]
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["demo-kit"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "demo-kit.package-health",
            "label": "Demo Kit validates the default demo homepage, showcase widgets, media, runtime assets, package capabilities, cache eligibility, and public render contract.",
            "class": "Capell\\DemoKit\\Health\\DemoKitHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "The demo engine for Capell: deterministic, multi-site, multi-language sample content and media. Generates a curated showcase site, fans out to each installed package's own demo command, and ships a health doctor so every demo, screenshot, and QA run starts from known data.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Demo Kit extension preview image",
                "caption": "Demo Kit extension preview"
            },
            {
                "path": "docs/screenshots/demo-kit-admin-page.png",
                "alt": "Demo Kit admin page for deterministic content generation",
                "caption": "Start repeatable demo generation from Capell Admin"
            },
            {
                "path": "docs/screenshots/demo-kit-admin-page-dark.png",
                "alt": "Demo Kit admin page in dark mode",
                "caption": "Dark-mode admin capture for demo generation"
            }
        ],
        "categories": ["admin", "console", "foundation", "frontend"],
        "keywords": [
            "demo-data",
            "seeding",
            "fixtures",
            "screenshot-automation",
            "multi-site",
            "multi-language",
            "deterministic-seed",
            "qa-tooling",
            "showcase",
            "foundation"
        ]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
