{
    "manifest-version": 3,
    "name": "capell-app/demo-kit",
    "slug": "demo-kit",
    "displayName": "Demo Kit",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "launchStatus": "shipped",
    "description": "Fills a local or test copy of Capell with example sites, pages, media and users, so you can explore before adding real content.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\DemoKit",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder",
            "capell-app/theme-foundation"
        ],
        "supports": [
            "capell-app/form-builder",
            "capell-app/html-cache",
            "capell-app/navigation"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\DemoKit\\Providers\\DemoKitServiceProvider",
            "Capell\\DemoKit\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": ["Capell\\DemoKit\\Providers\\ConsoleServiceProvider"],
        "runtime": ["Capell\\DemoKit\\Providers\\DemoKitServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitAdminPageContribution",
            "pageClass": "Capell\\DemoKit\\Filament\\Pages\\DemoKitPage",
            "labelKey": "capell-demo-kit::page.title"
        },
        {
            "type": "configurator",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitConfiguratorContribution",
            "configuratorClasses": [
                "Capell\\DemoKit\\Filament\\Configurators\\Widgets\\HomepageSectionWidgetConfigurator"
            ],
            "groups": ["layout-widget"]
        },
        {
            "type": "asset",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitAssetsContribution",
            "surface": "frontend",
            "assets": [
                "resources/views/**/*.blade.php",
                "resources/css/demo-homepage.css",
                "resources/dist/images/*.jpg",
                "demo/img/test.svg",
                "demo/video/SampleVideo_1280x720_1mb.mp4"
            ]
        },
        {
            "type": "frontend-component",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitFrontendComponentsContribution",
            "componentClasses": [
                "Capell\\DemoKit\\Livewire\\KitchenSinkStressWidget",
                "Capell\\DemoKit\\Livewire\\ResourcesLibrary",
                "Capell\\DemoKit\\Support\\KitchenSinkPublicLayoutWidgetPayloadContributor"
            ]
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitRenderablesContribution",
            "renderableKeys": [
                "capell.widget.demo-page-content",
                "capell.widget.homepage-section",
                "capell-demo-kit.widget.kitchen-sink-livewire-stress"
            ],
            "bladeViews": [
                "capell-demo-kit::widget.demo-page-content",
                "capell-demo-kit::widget.homepage-section"
            ],
            "livewireComponents": ["capell-demo-kit.kitchen-sink-stress-widget"]
        },
        {
            "type": "console-command",
            "class": "Capell\\DemoKit\\Manifest\\DemoKitConsoleCommandsContribution",
            "commands": [
                "capell:demo",
                "capell:admin-demo",
                "capell:demo-kit-full-demo",
                "capell:demo-kit-doctor",
                "capell:demo-kit-screenshot-fixture",
                "capell:demo-kit-refresh-stitch-pages",
                "capell:demo-kit-kitchen-sink"
            ],
            "commandClasses": [
                "Capell\\DemoKit\\Console\\Commands\\DemoCommand",
                "Capell\\DemoKit\\Console\\Commands\\AdminDemoCommand",
                "Capell\\DemoKit\\Console\\Commands\\FullDemoCommand",
                "Capell\\DemoKit\\Console\\Commands\\DemoKitDoctorCommand",
                "Capell\\DemoKit\\Console\\Commands\\DemoKitScreenshotFixtureCommand",
                "Capell\\DemoKit\\Console\\Commands\\RefreshDemoStitchPagesCommand",
                "Capell\\DemoKit\\Console\\Commands\\KitchenSinkDemoCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\DemoKit\\Health\\DemoKitHealthCheck",
            "checkClass": "Capell\\DemoKit\\Health\\DemoKitHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["capell_demo_kit_generation_runs"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:demo-kit-full-demo",
        "demoParams": [
            "url",
            "user",
            "languages",
            "sites",
            "site-count",
            "page-count",
            "packages",
            "theme",
            "seed",
            "quick",
            "reset",
            "skip-demo-users",
            "allow-production",
            "allow-non-local",
            "adopt-existing-site",
            "skip-package-demos",
            "force"
        ],
        "doctor": "capell:demo-kit-doctor"
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["frontend-rendering"],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\DemoKit\\Models\\DemoKitGenerationRun::$created_content",
                "Capell\\DemoKit\\Models\\DemoKitGenerationRun::$parameters",
                "Capell\\DemoKit\\Models\\DemoKitGenerationRun::$review"
            ],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\DemoKit\\Actions\\PrepareDemoKitScreenshotFixtureAction",
                "Capell\\DemoKit\\Actions\\RedactDemoKitErrorMessageAction",
                "Capell\\DemoKit\\Console\\Commands\\AdminDemoCommand",
                "Capell\\DemoKit\\Jobs\\RunDemoKitGenerationJob"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\DemoKit\\Support\\Creator\\DemoResourceResolver"
            ]
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["demo-kit"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\PageUrl",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\SiteDomain",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\Translation",
                    "events": ["saved", "deleted"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "demo-kit.package-health",
            "label": "Demo Kit validates the default demo homepage, showcase widgets, media, runtime assets, package capabilities, cache eligibility, and public render contract.",
            "class": "Capell\\DemoKit\\Health\\DemoKitHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Get realistic example sites to click through, with a plan you review before anything is created.",
        "description": "Developers, agencies and evaluators get example content for non-live copies. The default plan creates three sites with one to four languages each and twelve to thirty pages per site. A quick option builds one site with three pages. Installed packages are asked to add their own example content, and a reference page shows around 120 building blocks for testing. A check command confirms the demo homepage is published with its sections in place and enough sample media. The command line blocks production unless a developer passes an override, and the System page only works on local and test copies.",
        "problem": "My new Capell install is empty, so I can't show a client what it can do.",
        "outcome": "A populated local copy to click through, demonstrate or screenshot, which you can reset when finished.",
        "faq": [
            {
                "question": "Can I use Demo Kit on my live site?",
                "answer": "It is built to stay off live sites. The admin page appears only on local and test copies, and the two sample users, who share the public password password, are never created anywhere else. The command-line tools refuse a live site unless your developer overrides that on purpose."
            },
            {
                "question": "Is the demo content real?",
                "answer": "No. All the text is invented and the sample images come from capell.app. Replace both before launch."
            },
            {
                "question": "Can I get the same demo sites every time?",
                "answer": "Yes. Set a fixed number in the settings file and Demo Kit plans the same sites and pages on every run. Without one, each run is different."
            },
            {
                "question": "Will Reset delete the sites I made myself?",
                "answer": "No. Reset clears the sites Demo Kit made and leaves your own alone."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Demo Kit card with its admin page in light and dark themes above steps labelled Seed, Showcase and Reset.",
                "caption": "The card shows the same admin page in the light and dark themes."
            },
            {
                "path": "docs/screenshots/demo-kit-admin-page.png",
                "alt": "Demo Kit admin page with an Example site data panel and a Plan demo generation button at the top right.",
                "caption": "An administrator starts a demo run from here by planning it, then confirming."
            },
            {
                "path": "docs/screenshots/demo-kit-admin-page-dark.png",
                "alt": "Dark theme of the Demo Kit admin page with the Example site data panel and the Plan demo generation button.",
                "caption": "The demo kit admin page in the dark admin theme, with the same controls."
            }
        ],
        "categories": ["admin", "console", "foundation", "frontend"],
        "keywords": [
            "demo-data",
            "seeding",
            "fixtures",
            "screenshot-automation",
            "multi-site",
            "multi-language",
            "deterministic-seed",
            "qa-tooling",
            "showcase",
            "foundation"
        ]
    },
    "contributionTraceability": {
        "deferredContributions": [],
        "contributions": [
            {
                "type": "admin-action-extender",
                "key": "welcome-tour:capell-demo-kit.extensions",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell-demo-kit.widget.kitchen-sink-livewire-stress",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.demo-page-content",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.homepage-section",
                "providerBucket": "runtime"
            }
        ]
    }
}
